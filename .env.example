# ─── HTTP ────────────────────────────────────────────────────────
HTTP_ADDR=:8080
HTTP_TCP_POOL_SIZE=8
WEB_ROOT=web
HTTP_READ_HEADER_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=15
HTTP_IDLE_TIMEOUT_SECONDS=60
# HTTP_WRITE_TIMEOUT_SECONDS, HTTP_BACKEND_TIMEOUT_MS, HTTP_SHUTDOWN_TIMEOUT_MS and
# HTTP_TCP_RECONNECT_BACKOFF_MS are in the Timeouts section at the bottom.

# ─── TCP ─────────────────────────────────────────────────────────
TCP_LISTEN=:9000
# TCP_REQUEST_TIMEOUT_MS is in the Timeouts section at the bottom.

# ─── MySQL (single-node, used by seed/lookup before sharding) ───
# DATA
MYSQL_DATA_MAX_OPEN=50
MYSQL_DATA_MAX_WAIT_MS=200
MYSQL_DATA_CONN_MAX_LIFETIME_SECONDS=300
MYSQL_DATA_MAX_IDLE_TIME_SECONDS=120
MYSQL_DATA_SWEEP_INTERVAL_SECONDS=30
MYSQL_DATA_MAX_BAD_CONN_RETRIES=2

# LOOKUP
MYSQL_LOOKUP_MAX_OPEN=50
MYSQL_LOOKUP_MAX_WAIT_MS=200
MYSQL_LOOKUP_CONN_MAX_LIFETIME_SECONDS=300
MYSQL_LOOKUP_MAX_IDLE_TIME_SECONDS=120
MYSQL_LOOKUP_SWEEP_INTERVAL_SECONDS=30
MYSQL_LOOKUP_MAX_BAD_CONN_RETRIES=2
# MYSQL_*_LOCK_WAIT_TIMEOUT_SECONDS are in the Timeouts section at the bottom.

# ─── Sharding ───────────────────────────────────────────────────
# Comma-separated DSNs for data and lookup shards.
# Data shards: 3211 (data_0), 3212 (data_1). Lookup shards: 3221 (lookup_0), 3222 (lookup_1).
DATA_SHARD_DSNS=app:app@tcp(127.0.0.1:3211)/data_0?parseTime=true&charset=utf8mb4,app:app@tcp(127.0.0.1:3212)/data_1?parseTime=true&charset=utf8mb4
LOOKUP_SHARD_DSNS=app:app@tcp(127.0.0.1:3221)/lookup_0?parseTime=true&charset=utf8mb4,app:app@tcp(127.0.0.1:3222)/lookup_1?parseTime=true&charset=utf8mb4
SHARD_VNODES=150

# ─── ID generation ──────────────────────────────────────────────
MACHINE_ID=0

# ─── Redis ──────────────────────────────────────────────────────
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=50
REDIS_MIN_IDLE_CONNS=10
REDIS_CONN_MAX_LIFETIME_SECONDS=1800
REDIS_POOL_TIMEOUT_MS=200
REDIS_IO_TIMEOUT_MS=500
REDIS_PING_TIMEOUT_SECONDS=2
# Set to "off" to disable user/profile cache; anything else leaves it on.
CACHE_LAYER=on
CACHE_AUTH_TTL_SECONDS=600
CACHE_USER_TTL_SECONDS=3600
CACHE_LOOKUP_TTL_SECONDS=600

# ─── Uploads ────────────────────────────────────────────────────
UPLOADS_ROOT=uploads
UPLOADS_MAX_BYTES=2097152

# ─── Bcrypt ─────────────────────────────────────────────────────
# Cost 5: tuned for login-RPS targets (see system_design.md §4.3/§7).
# Must match whatever cost the seeder wrote.
BCRYPT_COST=5

# ─── Sessions ───────────────────────────────────────────────────
SESSION_TTL_SECONDS=86400

# ─── Lock Stack ─────────────────────────────────────────────────
# Timing settings (lock / lease TTLs, budgets, waits) are in the Timeouts section.
LOCKSTACK_MAX_DEADLOCK_RETRIES=2
LOCKSTACK_CACHE_TTL_SECONDS=3600
LOCKSTACK_POLL_MIN_US=500
LOCKSTACK_POLL_MAX_US=4000
LOCKSTACK_MAX_LOCK_RETRIES=200

# ═══ Timeouts ══════════════════════════════════════════════════
# Every timeout that interacts with another one lives here, so the rules
# between them can be checked in one place.
#
# ENFORCED — both servers refuse to start if these don't hold:
#
#   HTTP_WRITE_TIMEOUT  >  HTTP_BACKEND_TIMEOUT  >  TCP_REQUEST_TIMEOUT
#        15s                     5s                       4s
#   (the TCP server must give up before the HTTP server stops waiting for
#    it, or a request that "timed out" for the client can still complete
#    later; the HTTP server then still needs time to write the response)
#
#   MYSQL_*_LOCK_WAIT  <  LOCKSTACK_MIN_WRITE_BUDGET  <  min(TCP_REQUEST_TIMEOUT, LOCKSTACK_WATCHDOG_TTL)
#         1s                       1.5s                             4s
#   (a DB write only starts with MIN_WRITE_BUDGET left before the write's
#    deadline; MySQL gives up on a statement queued behind a lock within
#    LOCK_WAIT — so nothing can commit after the lock-stack lock expired,
#    which would leave the cache stale with nobody left to refresh it)
#
# RECOMMENDED — not enforced, but keep them:
#
#   LOCKSTACK_WATCHDOG_TTL     <= TCP_REQUEST_TIMEOUT   fallback cap; the request deadline wins anyway
#   LOCKSTACK_LOCK_TTL         <= LOCKSTACK_WATCHDOG_TTL raised automatically if not
#   LOCKSTACK_MAX_LOCKED_WAIT  <  TCP_REQUEST_TIMEOUT   readers fall back to an uncached DB read with time left
#   LOCKSTACK_LEASE_TTL        >  MYSQL_DATA_MAX_WAIT_MS (pool wait only) + a normal PK read (a few ms)
#                                 a lease should outlive its DB read; reads have no timeout of their own
#                                 (only the request deadline), so a slower read just drops its fill (safe)
#   LOCKSTACK_CLEANUP_TIMEOUT  >  REDIS_IO_TIMEOUT_MS   cleanup gets at least one full Redis round trip
#
# If you change HTTP_BACKEND_TIMEOUT, move TCP_REQUEST_TIMEOUT (and with it
# WATCHDOG_TTL / MIN_WRITE_BUDGET) so the chains above still hold.

# Request chain (outermost first)
HTTP_WRITE_TIMEOUT_SECONDS=15
HTTP_BACKEND_TIMEOUT_MS=5000
TCP_REQUEST_TIMEOUT_MS=4000
LOCKSTACK_WATCHDOG_TTL_MS=4000
LOCKSTACK_MIN_WRITE_BUDGET_MS=1500
# MySQL session lock_wait_timeout + innodb_lock_wait_timeout (whole seconds, minimum 1)
MYSQL_DATA_LOCK_WAIT_TIMEOUT_SECONDS=1
MYSQL_LOOKUP_LOCK_WAIT_TIMEOUT_SECONDS=1

# Lock stack leases and waits
# Writer lease TTL between watchdog refreshes; also how fast a crashed writer's lock frees up
LOCKSTACK_LOCK_TTL_MS=2000
# Reader lease TTL: one DB query + margin
LOCKSTACK_LEASE_TTL_MS=500
# How long a reader waits on a writer lease before reading the DB uncached (default 2 × LOCK_TTL)
LOCKSTACK_MAX_LOCKED_WAIT_MS=4000
# Post-write Redis cleanup (write-through finish, lease release) — runs even after the deadline
LOCKSTACK_CLEANUP_TIMEOUT_MS=2000

# Operational
HTTP_SHUTDOWN_TIMEOUT_MS=5000
HTTP_TCP_RECONNECT_BACKOFF_MS=1000
